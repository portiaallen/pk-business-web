{
  "name": "pk-business-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:security:phase1a": "node --test scripts/test-phase1a.mjs && node scripts/test-card-checkout.mjs",
    "test:security:phase1b": "prisma generate && node --import tsx --test scripts/test-phase1b.mts",
    "test:browser:phase1b": "prisma generate && node --import tsx scripts/verify-phase1b-browser.mts",
    "test:security:phase1c": "prisma generate && node --import tsx --test scripts/test-phase1c.mts",
    "test:browser:phase1c": "prisma generate && node --import tsx scripts/verify-phase1b-browser.mts --vault",
    "qualify:netlify:local": "node scripts/qualify-netlify-local.mjs && node scripts/test-netlify-artifact.mjs && node scripts/test-netlify-handler.mjs",
    "test:netlify:artifact": "node scripts/test-netlify-artifact.mjs",
    "test:netlify:handler": "node scripts/test-netlify-handler.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "nodemailer": "^9.0.5",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/plugin-nextjs": "5.16.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
