# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:4321

# ─── Database ──────────────────────────────────────────────────────────────────
# LOCAL: SQLite file (default)
DATABASE_URL="file:./prisma/dev.db"

# VERCEL / PRODUCTION: Turso (recommended — free tier, works with current schema)
# 1. Create a database at https://turso.tech
# 2. Set these in Vercel → Settings → Environment Variables:
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
# 3. From your machine, push schema: DATABASE_URL=... DATABASE_AUTH_TOKEN=... npx prisma db push
# 4. Seed demo data: POST /api/setup/seed with header x-setup-secret (see SETUP_SECRET)

# ─── One-time production seed ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# SETUP_SECRET=

# ─── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-in-production-use-openssl-rand

# ─── Email / Notifications ───────────────────────────────────────────────────
EMAIL_PROVIDER=mock

GMAIL_USER=portiaallen40@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=portiaallen40@gmail.com

# ─── Document Storage ──────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.storage/documents

# ─── Payments ──────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
