# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:4321
# NEXT_PUBLIC_APP_URL=https://pkservices.business

# ─── Database ────────────────────────────────────────────────────────────────
# LOCAL: SQLite file (default)
DATABASE_URL="file:./prisma/dev.db"

# VERCEL / PRODUCTION: Turso (recommended — free tier, works with current schema)
# 1. Create a database at https://turso.tech
# 2. Set these in Vercel → Settings → Environment Variables:
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
# 3. From your machine, push schema: DATABASE_URL=... DATABASE_AUTH_TOKEN=... npx prisma db push
# 4. Seed demo data: POST /api/setup/seed with header x-setup-secret (see SETUP_SECRET)
#    Demo seeding is for local development only. Production uses invite-only client access.

# ─── One-time production seed ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Used to HMAC-hash session tokens and to access detailed /api/health diagnostics (x-setup-secret header).
# SETUP_SECRET=

# ─── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-in-production-use-openssl-rand

# ─── Email / Notifications ─────────────────────────────────────────────────────
EMAIL_PROVIDER=mock

GMAIL_USER=portiaallen40@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=portiaallen40@gmail.com

# ─── Document Storage ────────────────────────────────────────────────────────
# LOCAL DEV:
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.storage/documents

# PRODUCTION (free): Cloudflare R2 — do NOT include bucket name in S3_ENDPOINT
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://5e86ae4fd1fecb21050ce543b434da33.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_BUCKET=pk-business-documents
# S3_REGION=auto

# PRODUCTION (paid): Vercel Blob — requires Vercel Pro
# STORAGE_PROVIDER=blob
# BLOB_READ_WRITE_TOKEN=

# ─── Payments ──────────────────────────────────────────────────────────────────
# Use mock until Stripe is configured. Set to stripe when live.
PAYMENT_PROVIDER=mock

# Cash App — cashtag or full pay URL (server only)
# CASH_APP_PAYMENT_DESTINATION=$YourCashtag

# Zelle — shown to clients after they choose Zelle (server only)
# ZELLE_PAYMENT_INSTRUCTIONS=Send via Zelle to email@example.com or 555-555-5555. Include your business name in the memo.

# Stripe — server secrets only (never NEXT_PUBLIC_ on secret key)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Inventory Tracker (shared auth across subdomains) ───────────────────────
# Production: set on BOTH main app and inventory.pkservices.business Vercel projects
# COOKIE_DOMAIN=.pkservices.business
# NEXT_PUBLIC_INVENTORY_URL=https://inventory.pkservices.business
# NEXT_PUBLIC_MAIN_APP_URL=https://www.pkservices.business
