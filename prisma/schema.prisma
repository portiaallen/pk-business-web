// PK Business Services — platform schema
// Shared between main app and inventory tracker

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClientMemberRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum VerificationRequestStatus {
  DRAFT
  SUBMITTED
  DOCUMENTS_REQUIRED
  UNDER_REVIEW
  VERIFICATION_IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum DocumentCategory {
  IDENTITY
  INCOME
  EMPLOYMENT
  BUSINESS
  TAX
  BANKING
  OTHER
}

enum DocumentUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum DeliverableVisibility {
  DRAFT
  RELEASED
}

enum DocumentRetentionStatus {
  ACTIVE
  SCHEDULED_FOR_DELETION
  DELETED
}

enum PaymentStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  UNPAID
  PENDING
  FAILED
  REFUNDED
  CANCELLED
  VOID
}

enum PaymentMethod {
  STRIPE
  CASH_APP
  ZELLE
  MANUAL
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  USER_CREATED
  CLIENT_CREATED
  CLIENT_MEMBER_ADDED
  CLIENT_MEMBER_REMOVED
  REQUEST_CREATED
  REQUEST_STATUS_CHANGED
  REQUEST_ASSIGNED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  DOCUMENT_DELETED
  INTERNAL_NOTE_ADDED
  REPORT_GENERATED
  ADMIN_ACTION
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  FORM_STARTED
  FORM_SAVED
  FORM_SUBMITTED
  DOCUMENT_REQUESTED
  CHANGES_REQUESTED
  DELIVERABLE_UPLOADED
  PAYMENT_CREATED
  PAYMENT_STATUS_CHANGED
  LOGIN_FAILED
}

enum FormSubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  COMPLETED
}

enum QbReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_CLEANUP
  ON_HOLD
  COMPLETED
}

enum QbCheckItemStatus {
  NOT_REVIEWED
  REVIEWED
  LOOKS_GOOD
  NEEDS_INVESTIGATION
  CLEANUP
  CRITICAL
  NOT_APPLICABLE
}

enum QbQuestionStatus {
  OPEN
  SENT
  ANSWERED
  RESOLVED
}

enum QbDocType {
  QBO_REPORT
  QBO_EXPORT
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  RECONCILIATION_REPORT
  TRANSACTION_DETAIL
  GENERAL_LEDGER
  P_AND_L
  BALANCE_SHEET
  TRIAL_BALANCE
  SUPPORTING_DOC
  OTHER
}

enum DocumentRequestStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  ACCEPTED
  CHANGES_REQUESTED
  COMPLETED
}

// ─── Users & auth ──────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  securityVersion Int @default(0)
  mfaEnrollmentAllowed Boolean @default(false)
  mfaEnrollmentExpiresAt DateTime?
  webauthnCredentials WebAuthnCredential[]
  recoveryCodes RecoveryCode[]
  securityChallenges SecurityChallenge[]
  capabilityGrants CapabilityGrant[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  clientMemberships    ClientMember[]
  assignedRequests     VerificationRequest[] @relation("AssignedStaff")
  reviewedDocuments    Document[]            @relation("DocumentReviewer")
  internalNotes        InternalNote[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  notifications        Notification[]
  clientMessages       ClientMessage[]
  messageReads         ClientMessageRead[]
  uploadedDeliverables Deliverable[]         @relation("DeliverableUploader")
  releasedDeliverables Deliverable[]         @relation("DeliverableReleaser")
  timeEntries          TimeEntry[]           @relation("TimeEntryUser")
  qbCleanupReviews     QbCleanupReview[]     @relation("QbReviewer")
  inventoryMembers     InventoryMember[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionPerformer")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  securityVersion Int @default(-1)
  assurance String @default("PASSWORD")
  passwordVerifiedAt DateTime @default(now())
  mfaVerifiedAt DateTime?
  lastSeenAt DateTime @default(now())
  activeClientId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Clients (tenants) ─────────────────────────────────────────────────────────

model Client {
  id        String       @id @default(cuid())
  name      String       // Business name
  status    ClientStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members              ClientMember[]
  verificationRequests VerificationRequest[]
  invoices             Invoice[]
  payments             Payment[]
  inventoryMembers     InventoryMember[]
  inventoryLocations   InventoryLocation[]
  inventoryProducts    InventoryProduct[]
  inventoryTransactions InventoryTransaction[]
}

// ─── Client membership (multi-user businesses) ────────────────────────────────

model ClientMember {
  id        String           @id @default(cuid())
  clientId  String
  userId    String
  role      ClientMemberRole @default(STAFF)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

// ─── Service catalog ───────────────────────────────────────────────────────────

model Service {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  name                  String
  shortName             String
  description           String
  shortDescription      String
  priceDisplay          String
  priceCents            Int?
  processingExpectation String?
  requiredDocuments     String        @default("[]") // JSON array of DocumentCategory values
  status                ServiceStatus @default(ACTIVE)
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  verificationRequests VerificationRequest[]
  invoices             Invoice[]
}

// ─── Verification requests (service requests) ──────────────────────────────────

model VerificationRequest {
  id              String                    @id @default(cuid())
  clientId        String
  serviceId       String
  requestType     String
  status          VerificationRequestStatus @default(DRAFT)
  requesterName   String?
  requesterEmail  String?
  requesterPhone  String?
  subjectName     String?
  subjectEmail    String?
  subjectPhone    String?
  clientNotes     String?
  assignedStaffId String?
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id])
  assignedStaff   User?           @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  documents       Document[]
  internalNotes   InternalNote[]
  findings        VerificationFinding[]
  result          VerificationResult?
  invoices        Invoice[]
  payments        Payment[]
  formSubmissions FormSubmission[]
  documentRequests DocumentRequest[]
  clientMessages  ClientMessage[]
  deliverables    Deliverable[]
  timeEntries     TimeEntry[]
  qbCleanupReview QbCleanupReview?
  aiReview        AiReview?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([assignedStaffId])
}

model InternalNote {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model VerificationFinding {
  id          String   @id @default(cuid())
  requestId   String
  title       String
  description String
  createdAt   DateTime @default(now())

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model VerificationResult {
  id          String   @id @default(cuid())
  requestId   String   @unique
  summary     String
  reportPath  String?
  generatedAt DateTime @default(now())

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ─── Documents ─────────────────────────────────────────────────────────────────

model Document {
  id              String                  @id @default(cuid())
  requestId       String
  category        DocumentCategory
  fileName        String
  mimeType        String
  fileSizeBytes   Int
  storageKey      String
  uploadStatus    DocumentUploadStatus    @default(PENDING)
  reviewStatus    DocumentReviewStatus    @default(PENDING)
  retentionStatus DocumentRetentionStatus @default(ACTIVE)
  uploadedAt      DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  request         VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer        User?               @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  documentRequest DocumentRequest?

  @@index([requestId])
  @@index([category])
}

// ─── Client paperwork ──────────────────────────────────────────────────────────

model FormSubmission {
  id          String               @id @default(cuid())
  requestId   String
  formKey     String
  status      FormSubmissionStatus @default(NOT_STARTED)
  data        String               @default("{}")
  currentStep Int                  @default(0)
  lastSavedAt DateTime?
  submittedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, formKey])
  @@index([requestId])
  @@index([status])
}

model DocumentRequest {
  id                String                @id @default(cuid())
  requestId         String
  title             String
  description       String?
  required          Boolean               @default(true)
  status            DocumentRequestStatus @default(REQUESTED)
  clientInstruction String?
  documentId        String?               @unique
  requestedAt       DateTime              @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  request  VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  document Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([status])
}

model ClientMessage {
  id          String   @id @default(cuid())
  requestId   String
  authorId    String
  body        String
  isFromStaff Boolean  @default(false)
  createdAt   DateTime @default(now())

  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads     ClientMessageRead[]

  @@index([requestId])
  @@index([createdAt])
}

// Per-user read receipts for tenant-isolated read/unread state
model ClientMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ClientMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Deliverable {
  id            String   @id @default(cuid())
  requestId     String
  title         String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  storageKey    String
  /** DRAFT (default): hidden from the client portal entirely. RELEASED: downloadable via the portal. */
  visibility    DeliverableVisibility   @default(DRAFT)
  releasedAt    DateTime?
  releasedById  String?
  uploadedById  String?
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  request    VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User?               @relation("DeliverableUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  releasedBy User?               @relation("DeliverableReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model IntakeSubmission {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  businessName  String?
  serviceSlug   String
  description   String
  contactMethod String   @default("email")
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel @default(EMAIL)
  status    NotificationStatus  @default(PENDING)
  subject   String
  body      String
  metadata  String              @default("{}")
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ─── Payments ───────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  clientId       String
  requestId      String?
  serviceId      String?
  description    String?
  lineItems      String        @default("[]")
  subtotalCents  Int           @default(0)
  adjustmentCents Int          @default(0)
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(DRAFT)
  paymentTerms   String?
  notes          String?
  paymentInstructions String?
  dueAt          DateTime?
  issueAt        DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client  Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  request VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  service Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  payments Payment[]
  activities InvoiceActivity[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceActivity {
  id        String   @id @default(cuid())
  invoiceId String
  event     String
  detail    String?
  actorId   String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                   String        @id @default(cuid())
  clientId             String
  invoiceId            String
  requestId            String?
  amountCents          Int
  currency             String        @default("USD")
  status               PaymentStatus @default(PENDING)
  method               PaymentMethod
  transactionReference String?
  notes                String?
  internalNotes        String?
  providerReference    String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  client  Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  request VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([invoiceId])
  @@index([requestId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

// ─── Audit logging ─────────────────────────────────────────────────────────────

/// Persistent login rate-limiting state (per-email). Survives restarts.

// ─── PK AI Assistant (Phase 1 MVP) ────────────────────────────────────────────

enum AiFindingStatus {
  NEEDS_REVIEW
  REVIEWED_NO_ISSUE
  NEEDS_INVESTIGATION
  POTENTIAL_CLEANUP
  CLIENT_CLARIFICATION
  OUT_OF_SCOPE
  DISMISSED
}

enum AiPriority {
  HIGH
  MEDIUM
  LOW
}

enum AiSource {
  AI_GENERATED
  SYSTEM_GENERATED
  HUMAN_CREATED
}

enum AiScopeAlertStatus {
  OPEN
  IGNORED
  INCLUDED_IN_SCOPE
  CLIENT_CLARIFICATION
  SCOPE_EXPANSION
  OUT_OF_SCOPE
}

enum AiClarificationStatus {
  DRAFT
  READY_TO_SEND
  SENT
  CLIENT_RESPONDED
  RESOLVED
}

/// One AI initial-review run per engagement (request). Complements the manual
/// QbCleanupReview — the AI surfaces findings so Portia can decide.
model AiReview {
  id          String   @id @default(cuid())
  requestId   String   @unique
  status      String   @default("PENDING") // PENDING | RUNNING | COMPLETE | FAILED
  summary     String?  // Advisor-facing initial review summary (markdown)
  engine      String   @default("rules") // rules | claude | hybrid
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  findings    AiFinding[]
  scopeAlerts AiScopeAlert[]
  activities  AiActivityLog[]
  clarifications AiClarification[] @relation("AiReviewClarifications")

  @@index([requestId])
  @@index([status])
}

model AiFinding {
  id              String          @id @default(cuid())
  reviewId        String
  category        String          // e.g. Reconciliation, Personal/Business, Payroll, Scope
  priority        AiPriority      @default(MEDIUM)
  status          AiFindingStatus @default(NEEDS_REVIEW)
  description     String
  evidence        String?         // JSON: transactions/accounts/reports supporting the finding
  relatedAccounts String?
  recommendation  String?         // AI recommendation — NEVER Portia's decision
  humanDecision   String?         // Portia's recorded decision
  humanNotes      String?
  decidedBy       String?
  decidedAt       DateTime?
  source          AiSource        @default(SYSTEM_GENERATED)
  checklistItemKey String?        // Maps to the manual QbCleanup checklist item where relevant
  estimatedHours  Float?          // For scope findings / work estimates
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  review        AiReview        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  decisions     AiDecision[]
  clarifications AiClarification[]

  @@index([reviewId])
  @@index([status])
  @@index([priority])
}

/// Record of every human approval/rejection — the approval gate trail.
model AiDecision {
  id              String   @id @default(cuid())
  findingId       String
  recommendation  String?  // What the AI proposed (snapshot)
  humanDecision   String
  approvedBy      String
  notes           String?
  createdAt       DateTime @default(now())

  finding AiFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
}

/// Scope-creep detection: work detected outside the engagement scope.
model AiScopeAlert {
  id             String              @id @default(cuid())
  reviewId       String
  description    String
  evidence       String?
  estimatedHours Float?
  status         AiScopeAlertStatus  @default(OPEN)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  review AiReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([status])
}

/// Client clarification queue (Phase 4 seed — kept modular for portal messaging).
model AiClarification {
  id            String               @id @default(cuid())
  reviewId      String
  findingId     String?
  question      String
  reason        String?
  relatedTransactions String?
  relatedAccount String?
  relatedPeriod String?
  amountCents   Int?
  status        AiClarificationStatus @default(DRAFT)
  clientResponse String?
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  review  AiReview   @relation("AiReviewClarifications", fields: [reviewId], references: [id], onDelete: Cascade)
  finding AiFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([findingId])
  @@index([status])
}

/// AI activity/audit log — distinguishes AI-generated vs human-approved vs system.
model AiActivityLog {
  id        String   @id @default(cuid())
  reviewId  String
  actorType AiSource @default(SYSTEM_GENERATED)
  actorId   String?
  action    String   // ANALYSIS_RUN | FINDING_GENERATED | RECOMMENDATION_GENERATED | DECISION_RECORDED | SCOPE_ALERT | STATUS_CHANGED | CHAT_MESSAGE
  detail    String?
  createdAt DateTime @default(now())

  review AiReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([action])
}

// ─── Time tracking (hourly billing) ───────────────────────────────────────────

model TimeEntry {
  id          String        @id @default(cuid())
  requestId   String
  userId      String
  category    String        // Work category
  note        String?       // Optional internal note
  startedAt   DateTime
  stoppedAt   DateTime?     // Null = timer still running
  durationSeconds Int       @default(0) // Stored duration on stop (null if running)
  isManual    Boolean       @default(false) // True if manually entered
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User               @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId])
  @@index([requestId, startedAt])
}

model QbCleanupReview {
  id              String       @id @default(cuid())
  requestId       String       @unique
  status          QbReviewStatus @default(NOT_STARTED)
  reviewerId      String
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  request  VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer User                @relation("QbReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  checklistItems    QbCleanupChecklistItem[] @relation("QbReviewChecklistItems")
  checklists        QbCleanupChecklist[]     @relation("QbChecklistReview")
  findings          QbCleanupFinding[]      @relation("QbReviewFindings")
  questions         QbCleanupQuestion[]     @relation("QbReviewQuestions")
  docLogs           QbCleanupDocLog[]       @relation("QbReviewDocLogs")
  notes             String?                 @default("")

  @@index([requestId])
  @@index([status])
  @@index([reviewerId])
}

model QbCleanupChecklist {
  id          String   @id @default(cuid())
  reviewId    String
  category    String
  itemKey     String
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  review QbCleanupReview @relation("QbChecklistReview", fields: [reviewId], references: [id], onDelete: Cascade)
  items  QbCleanupChecklistItem[] @relation("QbChecklistItemList")

  @@unique([reviewId, category, itemKey])
  @@index([reviewId])
}

model QbCleanupChecklistItem {
  id              String          @id @default(cuid())
  checklistId     String
  reviewId        String
  status          QbCheckItemStatus @default(NOT_REVIEWED)
  notes          String?
  isFollowUp     Boolean         @default(false)
  isDocumentationNeeded Boolean    @default(false)
  isCompleted    Boolean         @default(false)
  notApplicable   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  checklist QbCleanupChecklist @relation("QbChecklistItemList", fields: [checklistId], references: [id], onDelete: Cascade)
  review    QbCleanupReview    @relation("QbReviewChecklistItems", fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([checklistId])
  @@index([checklistId])
  @@index([reviewId])
}

model QbCleanupFinding {
  id              String          @id @default(cuid())
  reviewId        String
  checklistItemId String?
  category        String
  finding        String
  status          QbCheckItemStatus @default(NEEDS_INVESTIGATION)
  notes          String?
  isFollowUp     Boolean         @default(false)
  isDocumentationNeeded Boolean    @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  review QbCleanupReview @relation("QbReviewFindings", fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([checklistItemId])
  @@index([status])
}

model QbCleanupQuestion {
  id            String        @id @default(cuid())
  reviewId      String
  findingId     String?
  question      String
  status        QbQuestionStatus @default(OPEN)
  clientResponse String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  review QbCleanupReview @relation("QbReviewQuestions", fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([findingId])
  @@index([status])
}

model QbCleanupDocLog {
  id           String      @id @default(cuid())
  reviewId     String
  name         String
  docType      QbDocType
  dateOrPeriod String?
  description  String?
  checklistItemId String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  review QbCleanupReview @relation("QbReviewDocLogs", fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([checklistItemId])
  @@index([docType])
}

// ─── Time tracking (hourly billing) ───────────────────────────────────────────

model LoginRateLimit {
  id           String    @id @default(cuid())
  email        String    @unique
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  clientId   String?     // Tenant scope for B2B queries
  action     AuditAction
  resource   String
  resourceId String?
  metadata   String      @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([clientId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ─── Inventory Tracker (multi-tenant by Client) ───────────────────────────────
// These models are isolated for the inventory tracker product.
// They will be activated as a client-facing service in a future phase.

enum InventoryMemberRole {
  OWNER
  STAFF
  VIEWER
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  CORRECTION
}

model InventoryMember {
  id        String              @id @default(cuid())
  clientId  String
  userId    String
  role      InventoryMemberRole @default(STAFF)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

model InventoryLocation {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products InventoryProduct[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([isActive])
}

model InventoryProduct {
  id               String   @id @default(cuid())
  clientId         String
  name             String
  sku              String
  description      String?
  category         String?
  unit             String   @default("each")
  currentQuantity  Int      @default(0)
  reorderThreshold Int      @default(0)
  locationId       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location     InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transactions InventoryTransaction[]

  @@unique([clientId, sku])
  @@index([clientId])
  @@index([locationId])
  @@index([isActive])
  @@index([category])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  clientId        String
  productId       String
  transactionType InventoryTransactionType
  quantityChange  Int
  quantityBefore  Int
  quantityAfter   Int
  reason          String?
  notes           String?
  performedById   String
  createdAt       DateTime                 @default(now())

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product     InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedBy User             @relation("InventoryTransactionPerformer", fields: [performedById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([productId])
  @@index([performedById])
  @@index([transactionType])
  @@index([createdAt])
}

// Phase 1B: public authenticator material only; no private keys.
model WebAuthnCredential {
  id String @id
  userId String
  publicKey Bytes
  counter BigInt @default(0)
  transports String @default("[]")
  label String
  deviceType String
  backedUp Boolean
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model SecurityChallenge {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  challenge String
  purpose String
  passwordVerifiedAt DateTime @default(now())
  securityVersion Int
  sessionId String?
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model RecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String @unique
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
// scope is GLOBAL, CLIENT or REQUEST. Specialized client authorities are never role-derived.
model CapabilityGrant {
  id String @id @default(cuid())
  userId String
  capability String
  scope String
  clientId String @default("")
  requestId String @default("")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, capability, scope, clientId, requestId])
  @@index([userId, clientId])
}
